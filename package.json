{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "1.1.0",
  "description": "DeepSeek Harness 桌面版:将 dsh web 封装为原生桌面应用,内置引擎更新与自更新能力",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "DSH Desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/qq795595045/dsh-desktop.git"
  },
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "icon": "node scripts/generate-icon.js",
    "check:dsh": "node scripts/check-dsh.js",
    "update:dsh": "node scripts/update-dsh.js",
    "update:app": "bash scripts/update-app.sh",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac",
    "dist:all": "electron-builder --mac --linux --win",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deepseek.dsh.desktop",
    "productName": "DSH Desktop",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "updater.js",
      "autoupdate.js",
      "settings.js",
      "mock-server.js",
      "assets/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "qq795595045",
        "repo": "dsh-desktop",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "dmg": {
      "title": "DSH Desktop"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
